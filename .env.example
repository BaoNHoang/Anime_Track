VITE_ACCOUNT_AUTH_ENABLED=false
VITE_PASSKEY_AUTH_ENABLED=false
VITE_MCP_URL=https://your-banime-mcp-host.example/mcp

# Server-only values for Vercel Functions. Never prefix secrets with VITE_.
APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Required in production so account and library rate limits work across functions.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
