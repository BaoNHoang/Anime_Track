PORT=8787
MCP_PUBLIC_URL=https://your-banime-mcp-host.example/mcp
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
MCP_TRUST_PROXY=true

# Browser origins allowed to call the MCP endpoint. Server-to-server clients
# such as ChatGPT normally omit Origin. Do not use a wildcard.
MCP_ALLOWED_ORIGINS=https://your-banime-app.example

# Request protection defaults. Tune only after observing real traffic.
MCP_MAX_BODY_BYTES=65536
MCP_MAX_HEADER_BYTES=16384
MCP_MAX_CONCURRENT_REQUESTS=50
MCP_REQUEST_TIMEOUT_MS=30000
MCP_HEADERS_TIMEOUT_MS=10000
MCP_UPSTREAM_TIMEOUT_MS=15000
MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_TOOL_CALLS=40
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_TENRAI_RATE_LIMIT_REQUESTS=120

# Optional distributed rate limiting for multiple MCP replicas. Configure both
# values together. Without them, each process uses its own in-memory counters.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional production hardening. Set this only after a Supabase access-token
# hook issues the same audience value for the MCP OAuth client.
# MCP_EXPECTED_AUDIENCE=https://your-banime-mcp-host.example/mcp
